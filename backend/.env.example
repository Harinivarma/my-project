# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/lms_db?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# JWT Token Secret
JWT_SECRET=your_jwt_secret_key_at_least_64_characters_long

# Razorpay Configuration
RAZORPAY_KEY_ID=rzp_test_yourKeyId
RAZORPAY_KEY_SECRET=yourRazorpaySecret

# AI Quiz Generation API Configuration (Gemini API is used by default)
AI_API_KEY=your_gemini_api_key
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent
